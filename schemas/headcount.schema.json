{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Headcount snapshots",
  "type": "object",
  "required": ["version", "updated", "snapshots"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string" },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["company", "as_of", "employees", "is_estimate", "basis", "sources"],
        "additionalProperties": false,
        "properties": {
          "company": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "employees": { "type": "integer", "minimum": 1 },
          "is_estimate": { "type": "boolean" },
          "basis": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["title", "url"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    }
  }
}
