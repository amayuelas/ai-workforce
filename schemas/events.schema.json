{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workforce events (layoffs and hirings)",
  "type": "object",
  "required": ["version", "updated", "events"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "company", "date", "announced", "size", "size_is_estimate", "scope", "reason", "ai_related", "confidence", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "type": { "enum": ["layoff", "hiring"] },
          "kind": {
            "enum": ["buyout_offer", "internal_redeployment", "multi_company"],
            "description": "Optional refinement. buyout_offer: size = accepted/expected departures (null until known), eligible = offer pool. internal_redeployment and multi_company events are shown but never counted in totals."
          },
          "eligible": { "type": ["integer", "null"], "minimum": 1, "description": "Buyout offers only: number of employees offered the package." },
          "company": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "announced": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "size": { "type": ["integer", "null"], "minimum": 0 },
          "size_is_estimate": { "type": "boolean" },
          "percent_of_workforce": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "scope": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "ai_related": { "type": "boolean" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["title", "url"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    }
  }
}
